# Copy to .env and fill in. Never commit .env.

# Postgres connection. Neon URLs need ?sslmode=require
DATABASE_URL=postgresql://recon:recon@localhost:5433/recon

# Random secret for session and CSRF tokens:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# true on HTTPS (production), false for local http://
COOKIE_SECURE=false

# AI column-mapping suggestions (optional). Without a key, suggestions come from rules only.
# LLM_PROVIDER is groq (default) or anthropic; the key for the chosen provider is used.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Empty: openai/gpt-oss-120b on Groq, claude-opus-5-5 on Anthropic.
LLM_MODEL=

# Demo accounts created by the seed script
SEED_EXEC_EMAIL=exec@demo.local
SEED_EXEC_PASSWORD=
SEED_COFOUNDER_EMAIL=cofounder@demo.local
SEED_COFOUNDER_PASSWORD=

# Uploads
MAX_UPLOAD_MB=50
UPLOAD_DIR=./var/uploads
